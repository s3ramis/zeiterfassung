# Wird von docker-compose.full.yml für den PostgreSQL-Benutzer verwendet.
POSTGRES_PASSWORD=change_this_password

# PostgreSQL-Verbindung. Bei Docker Compose passt dieser Wert unverändert.
DATABASE_URL=postgresql://timepilot:timepilot_dev_password@localhost:5432/timepilot

# HTTP-Server
PORT=3001
HOST=127.0.0.1

# Erlaubte Browser-Ursprünge für den Entwicklungsbetrieb, kommasepariert.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Sitzungsdauer in Tagen
SESSION_DAYS=30

# Optional für verwaltete PostgreSQL-Dienste
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10
